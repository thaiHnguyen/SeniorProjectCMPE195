# Backend config: copy this file to `.env` in the repo root:
#     cp .env.example .env
# Then fill in your own values. `.env` is gitignored; never commit it.
# Only keys defined in backend/src/config/settings.py are allowed.


# Application
APP_NAME=Smart Hydroponic System
DEBUG=True
LOG_LEVEL=INFO

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Database (relative to the repo root)
DATABASE_PATH=./data/hydroponic.db

# Sensors: True on laptops, False to use real sensors on hardware ends
USE_MOCK_SENSORS=False
SENSOR_READ_INTERVAL=30

# Name shown in the dashboard navbar (defaults to the machine hostname)
#CONTROLLER_NAME=hydro-pi

# CORS-comma-separated frontend origins, or * for any
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000